#!/usr/bin/env bash
# nmclean - find node_modules folders and delete them all at once or one by one.
# https://github.com/OfirYaron/nmclean

VERSION="1.0.0"

usage() {
    cat <<EOF
nmclean $VERSION - find node_modules folders and reclaim disk space

Usage: nmclean [options] [dir]

Searches dir (default: \$NMCLEAN_ROOT, or the current directory) for
node_modules folders, lists them with sizes, then lets you delete them
all at once or decide one by one. Nested node_modules are skipped.

Options:
  -n, --dry-run   List folders and sizes only, delete nothing
  -y, --yes       Delete all found folders without asking
  -h, --help      Show this help
  -v, --version   Show version

Environment:
  NMCLEAN_ROOT    Default directory to search when none is given
EOF
}

dry_run=0
assume_yes=0
root=""

while [ $# -gt 0 ]; do
    case "$1" in
        -n|--dry-run) dry_run=1 ;;
        -y|--yes) assume_yes=1 ;;
        -h|--help) usage; exit 0 ;;
        -v|--version) echo "nmclean $VERSION"; exit 0 ;;
        -*) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
        *)
            if [ -n "$root" ]; then
                echo "Only one directory may be given." >&2
                exit 2
            fi
            root="$1"
            ;;
    esac
    shift
done

root="${root:-${NMCLEAN_ROOT:-$PWD}}"

if [ ! -d "$root" ]; then
    echo "Not a directory: $root" >&2
    exit 1
fi

# Print a size given in KB in human-readable form
hr() {
    awk -v kb="$1" 'BEGIN {
        if (kb >= 1048576) printf "%.1fG", kb / 1048576
        else if (kb >= 1024) printf "%.0fM", kb / 1024
        else printf "%dK", kb
    }'
}

# Read a single key from the terminal (works when launched from other scripts too)
ask() {
    local reply
    read -r -n 1 -p "$1" reply < /dev/tty
    echo >&2
    echo "$reply"
}

echo "Searching for node_modules in $root ..."

# -prune stops find from descending into node_modules, so nested ones are skipped
dirs=()
while IFS= read -r d; do
    dirs+=("$d")
done < <(find "$root" -type d -name node_modules -prune -print 2>/dev/null)

if [ ${#dirs[@]} -eq 0 ]; then
    echo "No node_modules folders found."
    exit 0
fi

sizes=()
total=0
for i in "${!dirs[@]}"; do
    kb=$(du -sk "${dirs[$i]}" 2>/dev/null | awk '{print $1}')
    kb=${kb:-0}
    sizes[$i]=$kb
    total=$((total + kb))
    printf "%3d) %7s  %s\n" $((i + 1)) "$(hr "$kb")" "${dirs[$i]}"
done

echo
echo "Found ${#dirs[@]} folders, $(hr "$total") total."

if [ "$dry_run" -eq 1 ]; then
    echo "Dry run: nothing deleted."
    exit 0
fi

echo

delete_dir() {
    # Only ever remove folders literally named node_modules
    if [ "$(basename "$1")" = "node_modules" ]; then
        rm -rf "$1" && return 0
    fi
    echo "  Failed to delete: $1"
    return 1
}

delete_all() {
    for i in "${!dirs[@]}"; do
        if delete_dir "${dirs[$i]}"; then
            freed=$((freed + sizes[$i]))
            echo "  Deleted ${dirs[$i]}"
        fi
    done
}

freed=0

if [ "$assume_yes" -eq 1 ]; then
    delete_all
else
    choice=$(ask "[a] delete all  [o] one by one  [q] quit: ")

    case "$choice" in
        a|A)
            confirm=$(ask "Delete all ${#dirs[@]} folders ($(hr "$total"))? [y/n]: ")
            if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
                echo "Cancelled."
                exit 0
            fi
            delete_all
            ;;
        o|O)
            for i in "${!dirs[@]}"; do
                reply=$(ask "($((i + 1))/${#dirs[@]}) $(hr "${sizes[$i]}")  ${dirs[$i]}  delete? [y/n/q]: ")
                case "$reply" in
                    y|Y)
                        if delete_dir "${dirs[$i]}"; then
                            freed=$((freed + sizes[$i]))
                            echo "  Deleted."
                        fi
                        ;;
                    q|Q)
                        break
                        ;;
                    *)
                        echo "  Skipped."
                        ;;
                esac
            done
            ;;
        *)
            echo "Nothing deleted."
            exit 0
            ;;
    esac
fi

echo
echo "Freed $(hr "$freed")."
